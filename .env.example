PORT=3000
DATABASE_PATH=data/better-resume.db

LLM_PROVIDER=openai_compatible
LLM_MODEL=your-model-id
LLM_REPORT_MODEL=your-fast-model-id
LLM_INTERVIEW_MODEL=your-strong-model-id
# Optional backup on the same provider/base URL. Empty disables fallback.
LLM_FALLBACK_MODEL=
LLM_WEAK_MODEL=your-fast-model-id
LLM_STRONG_MODEL=your-strong-model-id
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
# Optional RAG. Keep this empty to use static playbooks.
LLM_EMBEDDING_MODEL=
# When empty/unset, use LLM_BASE_URL and LLM_API_KEY.
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_TIMEOUT_SECONDS=30

# Whole-command deadline includes all agent requests and retries; must be below COMMAND_LEASE_MS.
COMMAND_DEADLINE_MS=90000
COMMAND_LEASE_MS=120000

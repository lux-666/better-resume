{
  "name": "better-resume",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx apps/server/src/index.ts",
    "dev:web": "vite apps/web",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts",
    "eval:model": "node --env-file-if-exists=.env --import tsx apps/server/src/evaluate-profiles.ts",
    "eval:routing": "node --env-file-if-exists=.env --import tsx apps/server/src/evaluate-routing.ts",
    "eval:routing:report-replay": "node --env-file-if-exists=.env --import tsx apps/server/src/evaluate-report-replay.ts",
    "build": "npm run typecheck && npm run build -w @better-resume/web",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:duplication && node --import tsx --test apps/*/src/*.test.ts packages/*/src/*.test.ts docs/architecture/structure.test.mjs",
    "eval:phase3": "node --env-file-if-exists=.env --import tsx apps/server/src/evaluate-phase3.ts",
    "eval:knowledge": "node --env-file-if-exists=.env --import tsx apps/server/src/evaluate-knowledge.ts",
    "eval:knowledge:questions": "node --env-file-if-exists=.env --import tsx apps/server/src/evaluate-knowledge-questions.ts",
    "eval:phase4": "node --env-file-if-exists=.env --import tsx apps/server/src/evaluate-phase4.ts",
    "backup": "node --env-file-if-exists=.env --import tsx apps/server/src/backup.ts",
    "check:duplication": "jscpd apps packages --min-tokens 70 --format typescript,tsx --ignore '**/*.test.ts' --threshold 0 --reporters console --silent"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jscpd": "5.0.16",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
